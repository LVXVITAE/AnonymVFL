# Company 节点专用镜像 - 移动联邦学习项目
FROM python:3.10

# 设置工作目录
WORKDIR /app

# 安装系统依赖
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# 复制依赖文件
COPY requirements.txt .

# 安装 Python 依赖
RUN pip install --no-cache-dir -r requirements.txt

# 验证 Ray Python API
RUN python3 -c "import ray; print('✅ Ray import OK:', ray.__version__)"

# 复制 Company 相关文件
COPY company/ ./company/
COPY trans/ ./trans/
COPY web_ui/ ./web_ui/
COPY data_full.csv .

# 创建模型目录
RUN mkdir -p /app/company/models

# 设置环境变量
ENV JAX_PLATFORMS=cpu \
    XLA_FLAGS="--xla_force_host_platform_device_count=1 --xla_cpu_multi_thread_eigen=false" \
    OMP_NUM_THREADS=1 \
    PYTHONUNBUFFERED=1 \
    NODE_ROLE=company

# 暴露端口
# 9394: Company SPU 端口
# 8080: Web UI 端口
# 6379: Ray Head 端口
EXPOSE 8080 9394 6379

# 默认命令
# COORDINATOR_SPU_ADDR 应通过环境变量或命令行参数指定独立的 Coordinator 地址
CMD ["python", "company/truerun.py", "--mode", "multi_distributed", \
    "--company_spu_addr", "0.0.0.0:9394", \
    "--partner_spu_addr", "partner:9395", \
    "--coordinator_spu_addr", "coordinator:9396", \
    "--ray_head_addr", "0.0.0.0:6379"]

